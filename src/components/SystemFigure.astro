---
import type { FlowStep } from '../data/projects';

interface Props {
  caption: string;
  steps: FlowStep[];
  label: string;
}

const { caption, steps, label } = Astro.props;
---

<figure class="figure">
  <figcaption class="figure__caption">{caption}</figcaption>
  <ol class="flow" aria-label={`${label}: how state moves through the system`}>
    {
      steps.map((step, i) => (
        <li>
          <div class:list={['flow__node', step.pivot && 'flow__node--pivot']}>
            <span class="flow__label">{step.node}</span>
            <span class="flow__note">{step.note}</span>
          </div>
          {step.edge && (
            <p class="flow__edge" style={`--edge-delay:${(i * 0.09).toFixed(2)}s`}>
              {step.edge}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</figure>
