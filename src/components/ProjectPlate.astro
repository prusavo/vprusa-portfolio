---
import type { Project } from '../data/projects';
import SystemFigure from './SystemFigure.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="plate" id={project.slug} data-observe style={`--accent:${project.accent}`}>
  <div class="plate__head">
    <span class="plate__swatch" aria-hidden="true"></span>
    <p class="tag plate__kicker">{project.kicker}</p>
  </div>

  <h3 class="plate__name">{project.name}</h3>
  <p class="plate__tagline">{project.tagline}</p>

  <div class="plate__body">
    {project.body.map((para) => <p>{para}</p>)}
  </div>

  <!-- Figure and spec sit side by side at width, the way a datasheet reads:
       the diagram on the left, the numbers against it on the right. -->
  <div class="plate__detail">
    <SystemFigure
      caption={project.figure.caption}
      steps={project.figure.steps}
      label={project.name}
    />

    <dl class="spec">
      {
        project.spec.map((row) => (
          <div class="spec__row">
            <dt class="spec__k">{row.k}</dt>
            <dd class="spec__v">{row.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</article>
