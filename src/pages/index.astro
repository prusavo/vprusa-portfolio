---
import Base from '../layouts/Base.astro';
import { site, links } from '../data/site';
import { projects } from '../data/projects';

const year = new Date().getFullYear();
---

<Base>
  <main class="page">
    <header>
      <p class="tag" data-reveal style="--d:0.05s">{site.domain}</p>
      <h1 class="name" data-reveal style="--d:0.1s">{site.name}</h1>
      <p class="tag role" data-reveal style="--d:0.16s">{site.role}</p>
      <p class="intro" data-reveal style="--d:0.24s">{site.intro}</p>
    </header>

    <section class="section" aria-labelledby="projects-label" data-reveal style="--d:0.34s">
      <p class="tag section__label" id="projects-label">Projects</p>

      <ul class="list">
        {
          projects.map((project) => (
            <li class="entry" style={`--accent:${project.accent}`}>
              <div class="entry__head">
                <span class="entry__dot" aria-hidden="true" />
                <h2 class="entry__name">{project.name}</h2>
              </div>
              <p class="entry__blurb">{project.blurb}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="contact-label" data-reveal style="--d:0.42s">
      <p class="tag section__label" id="contact-label">Contact</p>

      {
        links.map((link) => (
          <a
            class="row"
            href={link.href}
            rel={link.external ? 'me noopener noreferrer' : undefined}
            target={link.external ? '_blank' : undefined}
          >
            <span class="row__label">{link.label}</span>
            <span class="row__value">{link.value}</span>
            <span class="row__arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </section>

    <footer class="footer">
      <p class="tag">© {year} {site.name}</p>
    </footer>
  </main>
</Base>
