---
import Base from '../layouts/Base.astro';
import { site, links, media } from '../data/site';
import { projects } from '../data/projects';

const year = new Date().getFullYear();
---

<Base>
  <main class="page">
    <header class="hero">
      <div data-reveal style="--d:0.05s">
        <p class="tag">{site.domain}</p>
        <h1 class="name">Vojtěch<br />Prusa</h1>
        <p class="tag role">{site.role}</p>
        <p class="intro">{site.intro}</p>
      </div>

      <img
        class="hero__portrait"
        src={media.portrait.src}
        alt={media.portrait.alt}
        width={media.portrait.width}
        height={media.portrait.height}
        data-reveal
        style="--d:0.14s"
      />
    </header>

    <img
      class="ground"
      src={media.ink.src}
      alt=""
      aria-hidden="true"
      width={media.ink.width}
      height={media.ink.height}
      data-reveal
      style="--d:0.24s"
    />

    <section class="section" aria-labelledby="projects-label">
      <p class="tag section__label" id="projects-label">Live projects</p>

      <ul class="list">
        {
          projects.map((project) => (
            <li class="entry" style={`--accent:${project.accent}`}>
              <a class="entry__link" href={project.url} rel="noopener noreferrer" target="_blank">
                <div class="entry__media">
                  <img
                    src={project.image.src}
                    alt={project.image.alt}
                    width={project.image.width}
                    height={project.image.height}
                    loading="lazy"
                  />
                </div>

                <div class="entry__body">
                  <div class="entry__head">
                    <span class="entry__dot" aria-hidden="true" />
                    <h2 class="entry__name">{project.name}</h2>
                    <span class="entry__arrow" aria-hidden="true">
                      →
                    </span>
                  </div>
                  <p class="entry__blurb">{project.blurb}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="contact-label">
      <p class="tag section__label" id="contact-label">Contact</p>

      {
        links.map((link) => (
          <a
            class="row"
            href={link.href}
            rel={link.external ? 'me noopener noreferrer' : undefined}
            target={link.external ? '_blank' : undefined}
          >
            <span class="row__label">{link.label}</span>
            <span class="row__value">{link.value}</span>
            <span class="row__arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))
      }
    </section>

    <footer class="footer">
      <p class="tag">© {year} {site.name}</p>
    </footer>
  </main>
</Base>
