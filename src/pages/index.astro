---
import Base from '../layouts/Base.astro';
import { site, links, media } from '../data/site';
import { projects } from '../data/projects';

const year = new Date().getFullYear();
---

<Base>
  <main class="frame">
    <header class="hero">
      <div class="hero__panel" data-reveal style="--d:0.05s">
        <p class="tag hero__top">{site.domain}</p>

        <h1 class="hero__name">Vojtěch<br />Prusa</h1>
        <p class="tag hero__role">{site.role}</p>
        <p class="hero__intro">{site.intro}</p>
      </div>

      <div class="hero__photo" data-reveal style="--d:0.14s">
        <img
          src={media.portrait.src}
          alt={media.portrait.alt}
          width={media.portrait.width}
          height={media.portrait.height}
          fetchpriority="high"
        />
      </div>
    </header>

    <div class="wrap">
      <section class="section" aria-labelledby="projects-label">
        <p class="tag section__label" id="projects-label">Live projects</p>

        <ul class="list">
          {
            projects.map((project) => (
              <li class="project" style={`--accent:${project.accent}`}>
                <a
                  class="project__link"
                  href={project.url}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span class="project__head">
                    <h2 class="project__name">{project.name}</h2>
                    <span class="project__domain">{project.domain}</span>
                  </span>
                  <span class="project__side">
                    <span class="project__blurb">{project.blurb}</span>
                    <span class="project__arrow" aria-hidden="true">
                      →
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section" aria-labelledby="contact-label">
        <p class="tag section__label" id="contact-label">Contact</p>

        {
          links.map((link) => (
            <a
              class="row"
              href={link.href}
              rel={link.external ? 'me noopener noreferrer' : undefined}
              target={link.external ? '_blank' : undefined}
            >
              <span class="row__label">{link.label}</span>
              <span class="row__value">{link.value}</span>
              <span class="row__arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </section>

      <footer class="footer">
        <p class="tag">© {year} {site.name}</p>
      </footer>
    </div>
  </main>
</Base>
