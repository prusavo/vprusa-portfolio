---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
---

<Base
  title={`Page not found — ${site.name}`}
  description="This address has nothing behind it."
  noindex
>
  <Nav />

  <main class="hero shell" id="top">
    <p class="tag">Error 404</p>

    <h1 class="hero__title" style="font-size: clamp(2rem, 6vw, 4.25rem)">
      Nothing at this address.
    </h1>

    <p class="hero__lede">
      The page you asked for does not exist. The homepage has the work, what I do, and how to
      reach me.
    </p>

    <a class="channel" href="/">
      <span class="channel__label">Homepage</span>
      <span class="channel__handle">{site.domain}</span>
      <span class="channel__arrow" aria-hidden="true">→</span>
    </a>
  </main>
</Base>
